# Copy this file to .env and fill in real values. .env is ignored by Git.
#   cp .env.example .env

# --- PostgreSQL (n8n's own storage + the MarketBrief tables) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=n8n

# --- n8n ---
# Encrypts every credential n8n stores (Telegram token, API keys, DB password).
# Generate once with:  openssl rand -hex 32
# Never change it after the first start, or n8n can no longer read saved credentials.
N8N_ENCRYPTION_KEY=paste-the-output-of-openssl-rand-hex-32-here

# Time zone for the 08:00 weekday schedule
GENERIC_TIMEZONE=Europe/Paris

# Public address n8n gives to Telegram for its webhook.
# Telegram only accepts HTTPS, so for a real bot put a tunnel URL here
# (e.g. https://xxxx.trycloudflare.com/). Leave as is for a local-only run.
WEBHOOK_URL=http://localhost:5678/
